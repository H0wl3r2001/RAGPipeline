# ---- Required by PROJECT_BRIEF.md section 6 (Phase 1) ----
# LLM model served by the Ollama container.
# One-time setup: docker exec -it ragpipeline-ollama-1 ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# Qdrant connection (service name from docker-compose).
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Embedding model served by Ollama (small dedicated embedding model).
EMBED_MODEL=nomic-embed-text

# Number of chunks to retrieve per query.
TOP_K=4

# ---- Additional knobs (added for explicit connectivity/path config) ----
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
QDRANT_COLLECTION=rag_docs
DATA_DIR=/data
