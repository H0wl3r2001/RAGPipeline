# Secrets — never commit real values. Only .env.example is tracked.
.env

# Source documents — keep the folder but ignore its contents
data/*
!data/.gitkeep

# Eval virtualenv (local only, not containerized)
eval/.venv/

# Timestamped eval result JSON files (Phase 6). Folder stays in the repo
# so eval.py can write to it without git-tracking the outputs.
eval/results/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
